{
  "name": "@jobflow/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "start:all": "node src/server.js --with-worker",
    "dev": "node --watch src/server.js",
    "worker:dev": "node --watch src/worker.js",
    "users": "node scripts/users.js",
    "lint": "oxlint --deny-warnings src scripts test",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "db:memory": "node scripts/dev-db.js"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1143.0",
    "@google-cloud/bigquery": "^9.1.0",
    "@google/genai": "^2.24.0",
    "@hubspot/api-client": "^14.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "mongoose": "^9.10.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "oxlint": "^1.86.0",
    "supertest": "^7.3.0"
  }
}
